// SiteOS — production schema (PostgreSQL)
// NOTE: This sandbox cannot download Prisma's engine binaries (network policy
// blocks binaries.prisma.sh), so the running MVP in this environment uses an
// in-memory data layer with the identical shape (see lib/data/store.ts).
// This file is the real target schema — run `npx prisma migrate dev` with
// normal internet access to stand up Postgres, then swap lib/db to the
// generated Prisma client (service-layer function signatures are unchanged).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  SUPERVISOR
}

enum ProjectStatus {
  ON_TRACK
  AT_RISK
  CRITICAL
  COMPLETED
}

enum ExpenseCategory {
  MATERIALS
  LABOR
  TRANSPORT
  EQUIPMENT
  SUBCONTRACTORS
  UTILITIES
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  CARD
  OTHER
}

enum MaterialUnit {
  BAG
  KG
  TON
  M3
  UNIT
  METER
  LITER
}

enum MaterialTxType {
  PURCHASE
  CONSUMPTION
  ADJUSTMENT
}

enum AlertSeverity {
  WARNING
  CRITICAL
}

enum AlertType {
  BUDGET_CATEGORY_OVER
  BUDGET_PROGRESS_MISMATCH
  MATERIAL_LOW_STOCK
  EXPENSE_ANOMALY
  FORECAST_OVER_BUDGET
}

model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  passwordHash  String
  role          Role
  createdAt     DateTime        @default(now())
  memberships   ProjectMember[]
  dailyReports  DailyReport[]
  expenses      Expense[]
}

model Project {
  id                String          @id @default(cuid())
  name              String
  location          String
  client            String?
  startDate         DateTime
  expectedEndDate   DateTime
  status            ProjectStatus   @default(ON_TRACK)
  progressPercent   Int             @default(0)
  totalBudget       Decimal         @db.Decimal(14, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  members           ProjectMember[]
  expenses          Expense[]
  budgetCategories   BudgetCategory[]
  materials         Material[]
  dailyReports      DailyReport[]
  alerts            Alert[]
  aiReports         AIReport[]

  @@index([status])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model BudgetCategory {
  id            String          @id @default(cuid())
  projectId     String
  category      ExpenseCategory
  plannedAmount Decimal         @db.Decimal(14, 2)
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, category])
}

model Expense {
  id             String          @id @default(cuid())
  projectId      String
  amount         Decimal         @db.Decimal(14, 2)
  category       ExpenseCategory
  description    String
  supplier       String?
  date           DateTime
  paymentMethod  PaymentMethod
  receiptPhotoUrl String?
  notes          String?
  createdById    String
  createdAt      DateTime        @default(now())

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User            @relation(fields: [createdById], references: [id])

  @@index([projectId, date])
  @@index([projectId, category])
}

model Material {
  id                String              @id @default(cuid())
  projectId         String
  name              String
  unit              MaterialUnit
  currentStock      Decimal             @db.Decimal(12, 2)
  minStock          Decimal             @db.Decimal(12, 2)
  avgDailyUsage     Decimal             @db.Decimal(12, 2) @default(0)
  createdAt         DateTime            @default(now())

  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transactions      MaterialTransaction[]

  @@unique([projectId, name])
}

model MaterialTransaction {
  id          String          @id @default(cuid())
  materialId  String
  type        MaterialTxType
  quantity    Decimal         @db.Decimal(12, 2)
  date        DateTime
  note        String?
  createdAt   DateTime        @default(now())

  material    Material        @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId, date])
}

model DailyReport {
  id                 String              @id @default(cuid())
  projectId          String
  date               DateTime
  workerCount        Int
  workCompleted      String
  materialsReceived  String?
  materialsConsumed  String?
  issues             String?
  weather            String?
  notes              String?
  createdById        String
  createdAt          DateTime            @default(now())

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy          User                @relation(fields: [createdById], references: [id])
  photos             DailyReportPhoto[]

  @@unique([projectId, date])
}

model DailyReportPhoto {
  id             String       @id @default(cuid())
  dailyReportId  String
  url            String
  description    String?
  createdAt      DateTime     @default(now())

  dailyReport    DailyReport  @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
}

model Alert {
  id          String        @id @default(cuid())
  projectId   String
  type        AlertType
  severity    AlertSeverity
  message     String
  isResolved  Boolean       @default(false)
  createdAt   DateTime      @default(now())

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, isResolved])
}

model AIReport {
  id          String   @id @default(cuid())
  projectId   String
  date        DateTime
  summary     String
  isMocked    Boolean  @default(false)
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date])
}
